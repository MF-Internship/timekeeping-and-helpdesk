APP_ENV=development
DATABASE_URL=postgresql://app_runtime:local_runtime_only@127.0.0.1:5432/timekeeping
DJANGO_SECRET_KEY=local-development-only-change-me
DJANGO_DEBUG=true
API_DOCS_ENABLED=true
DJANGO_CACHE_BACKEND=locmem
REDIS_URL=rediss://local-placeholder.invalid/0
REDIS_KEY_PREFIX=timekeeping-development
R2_BUCKET=timekeeping-development
S3_ENDPOINT=https://example-account.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=local-development-access-key
S3_SECRET_ACCESS_KEY=local-development-secret-key
S3_REGION=auto
ORIGIN_CREDENTIAL_HEADER=X-Origin-Credential
ORIGIN_CREDENTIAL=local-development-origin-credential-32-chars
RECOVERY_DATABASE_URL=postgresql://recovery_reader:local-only@127.0.0.1:5433/restored_timekeeping
