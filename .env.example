# Backend runtime (development example; production values remain fail-closed).
APP_ENV=development
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=postgresql://app_runtime:local_runtime_only@127.0.0.1:5432/timekeeping
DJANGO_SECRET_KEY=local-development-only-change-me
DJANGO_DEBUG=true
API_DOCS_ENABLED=true
DJANGO_CACHE_BACKEND=locmem
REDIS_URL=rediss://local-placeholder.invalid/0
REDIS_KEY_PREFIX=timekeeping-development
R2_BUCKET=timekeeping-development
ORIGIN_CREDENTIAL_HEADER=X-Origin-Credential
ORIGIN_CREDENTIAL=local-development-origin-credential-32-chars
OUTBOX_RELAY_TRANSPORT=disabled

# Private object storage runtime values.
S3_ENDPOINT=https://example-account.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=local-development-access-key
S3_SECRET_ACCESS_KEY=local-development-secret-key
S3_REGION=auto

# Web Push backend runtime values. Keep disabled until a valid key pair is provisioned.
WEB_PUSH_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
WEB_PUSH_VAPID_PRIVATE_KEY=replace-with-vapid-private-key
WEB_PUSH_VAPID_SUBJECT=mailto:notifications@example.invalid
PUSH_SUBSCRIPTION_ENCRYPTION_KEY=replace-with-urlsafe-base64-encoded-32-byte-key
WEB_PUSH_ENABLED=false
WEB_PUSH_ALLOWED_ORIGINS=https://replace-with-approved-push-service-origin.invalid

# Frontend build/server values. NEXT_PUBLIC_* is intentionally browser-visible.
BACKEND_ORIGIN=http://127.0.0.1:8000
NEXT_PUBLIC_WEB_PUSH_APPLICATION_SERVER_KEY=replace-with-vapid-public-key

# Test-only PostgreSQL service. Use an isolated disposable database.
POSTGRES_TEST_DATABASE_URL=postgresql://runtime_test:runtime_test_password@127.0.0.1:5432/timekeeping_test

# Operator-only recovery check; never expose to the application runtime.
RECOVERY_DATABASE_URL=postgresql://recovery_reader:local-only@127.0.0.1:5433/restored_timekeeping
